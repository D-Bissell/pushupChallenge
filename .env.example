# Firebase web app config (safe to expose — these identify, not authorise).
# Without these the dashboard runs in "demo mode" using bundled sample data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Default team shown by the dashboard.
VITE_DEFAULT_TEAM_ID=a23
